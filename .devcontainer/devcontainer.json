{
    "name": "Java 21 Development Environment",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "vscjava.vscode-java-pack",
                "vmware.vscode-boot-dev-pack"
            ]
        }
    },
    "forwardPorts": [
        8080,
        8000
    ],
    "postCreateCommand": "python3 -m venv .venv && .venv/bin/pip install mkdocs",
    "remoteUser": "developer"
}