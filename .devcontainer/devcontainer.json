{
    "name": "Java 21 Development Environment",

    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "vscjava.vscode-java-pack",
                "vmware.vscode-boot-dev-pack"
            ]
        }
    },

    "forwardPorts": [
        8080,
        8000
    ],

    "runArgs": [
        "--mount",
        "type=bind,source=/var/run/docker.sock,target=/var/run/docker.sock",
        "--group-add",
        "986"
    ],

    "postCreateCommand": "python3 -m venv .venv && .venv/bin/python -m pip install mkdocs && .venv/bin/mkdocs --version && pre-commit --version && act --version",

    "remoteUser": "developer"
}